# Local JSON ideas use an in-memory auth adapter for development.
# Production auth requires postgres; credentials and sessions persist in PostgreSQL.
IDEAHUB_STORAGE=json
# Optional; ignored with the memory adapter.
IDEAHUB_DATA_FILE=./data/ideahub.json

# Server-only Supabase Transaction pooler URI from Dashboard > Connect.
# Set IDEAHUB_STORAGE=postgres after configuring this. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=
# Optional PEM root certificate if the database uses a private CA. TLS verification stays on.
DATABASE_SSL_CA=
# Set to 1 after applying all Supabase migrations out of band.
# This lets a restricted runtime role serve requests without running schema DDL.
IDEAHUB_SCHEMA_MANAGED=0

# Server-only Google Gemini settings. Existing saved/sample recaps work without a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite
# At least 16 random characters; Vercel sends it as the scheduled job bearer token.
CRON_SECRET=

# Google OAuth Web Application credentials; these are separate from Gemini API keys.
APP_URL=https://ideahub-umber.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI: https://ideahub-umber.vercel.app/api/auth/google/callback

# Cloudinary signed avatar uploads; keep all credentials server-side.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional server-side Redis cache (Upstash Free). Never prefix these with NEXT_PUBLIC_.
# Off by default: current production SQL is faster than remote Redis REST reads.
# Set true only after measuring a shared, read-heavy workload.
IDEAHUB_REDIS_CACHE=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Preview-only pilot. Keep disabled until cutoff and old tokens are tested.
IDEAHUB_MEETINGS_ENABLED=0
IDEAHUB_MEETINGS_PILOT_ID=
# Dedicated LiveKit Cloud project with room auto-creation disabled.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# At least 32 random chars. Mirror in the preview database's Vault.
IDEAHUB_MEETING_JOB_SECRET=
# Optional preview timing override. Production always uses 180/150 minutes.
IDEAHUB_MEETING_TEST_SECONDS=
IDEAHUB_MEETING_TEST_WARNING_SECONDS=
