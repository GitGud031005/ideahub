# Local JSON ideas use an in-memory auth adapter for development.
# Production auth requires postgres; credentials and sessions persist in PostgreSQL.
IDEAHUB_STORAGE=json
# Optional; ignored with the memory adapter.
IDEAHUB_DATA_FILE=./data/ideahub.json

# Server-only Supabase Transaction pooler URI from Dashboard > Connect.
# Set IDEAHUB_STORAGE=postgres after configuring this. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=
# Optional PEM root certificate if the database uses a private CA. TLS verification stays on.
DATABASE_SSL_CA=

# Server-only Google Gemini settings. Existing saved/sample recaps work without a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# At least 16 random characters; Vercel sends it as the scheduled job bearer token.
CRON_SECRET=
